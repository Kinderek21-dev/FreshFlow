<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreshFlow ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #F9FAFB;">
    <div class="d-flex min-vh-100">
        <aside class="d-flex flex-column p-3 text-white" style="width: 260px; background-color: #101828;">
            <div class="d-flex align-items-center gap-2 mb-4 px-2 py-2">
                <span class="px-2 py-1 rounded fw-bold" style="background-color:#00796B;">F</span>
                <div>
                    <div class="fw-bold leading-none">FreshFlow</div>
                    <small class="text-white-50" style="font-size:11px;">SYSTEM ERP</small>
                </div>
            </div>

            <small class="text-uppercase text-white-50 px-2 mb-2" style="font-size:11px;">Menu Główne</small>
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-white">⊞ Pulpit Główny</a>
                </li>
                <li>
                    <a asp-controller="Products" asp-action="Index" class="nav-link text-white">📦 Katalog Produktów (CRUD)</a>
                </li>
                <li>
                    <a asp-controller="Users" asp-action="Index" class="nav-link text-white">👥 Użytkownicy (CRUD Admina)</a>
                </li>
                <li>
                    <a asp-controller="ClientPanel" asp-action="Index" class="nav-link text-white-50">🌿 Podgląd Panelu Klienta</a>
                </li>
            </ul>

            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto">
                <button type="submit" class="btn btn-outline-light btn-sm w-100">⇥ Wyloguj</button>
            </form>
        </aside>

        <div class="flex-grow-1 d-flex flex-column">
            <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                <input type="search" class="form-control w-25 bg-light" placeholder="Szukaj w systemie..." />
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill p-2" style="background-color:#e6f4f1; color:#00796B;">ERP</span>
                    <div class="small">
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <div class="text-muted" style="font-size:11px;">Panel Pracownika / Admina</div>
                    </div>
                </div>
            </header>
            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>