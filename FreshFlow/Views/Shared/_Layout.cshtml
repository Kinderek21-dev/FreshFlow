<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreshFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg bg-white border-bottom py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark" asp-controller="Home" asp-action="Index">
                <span class="p-2 rounded-3 text-white" style="background-color:#00796B;">🍃</span>
                FreshFlow
            </a>
            <div class="collapse navbar-collapse justify-content-center">
                <ul class="navbar-nav gap-4 small fw-semibold">
                    <li class="nav-item"><a class="nav-link text-dark" href="#o-nas">O nas</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Products" asp-action="Catalog">Nasza Oferta</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="#dostawcy">Dostawcy</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="#kontakt">Kontakt</a></li>
                </ul>
            </div>
            <div class="d-flex gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="ClientPanel" asp-action="Index" class="btn btn-outline-dark btn-sm px-3 py-2 fw-semibold">Panel Klienta</a>
                    <a asp-controller="Products" asp-action="Catalog" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">Katalog</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm text-white px-3 py-2 fw-semibold" style="background-color:#00796B;">Wyloguj (@User.Identity.Name)</button>
                    </form>
                }

            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer id="kontakt" class="text-white pt-5 pb-4 mt-auto" style="background-color: #101828;">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-5 mb-2">
                        <span class="p-2 rounded-3" style="background-color:#00796B;">🍃</span> FreshFlow
                    </div>
                    <p class="small text-white-50">Twój zaufany partner w dostawach świeżych warzyw i owoców dla gastronomii i handlu.</p>
                </div>
                <div class="col-md-3 small">
                    <h6 class="text-uppercase fw-bold mb-3">Kontakt</h6>
                    <p class="text-white-50 mb-1">+48 22 450 20 10</p>
                    <p class="text-white-50 mb-1">biuro@freshflow.pl</p>
                    <p class="text-white-50">zamowienia@freshflow.pl</p>
                </div>
                <div class="col-md-3 small">
                    <h6 class="text-uppercase fw-bold mb-3">Hurtownia</h6>
                    <p class="text-white-50 mb-1">ul. Logistyczna 12</p>
                    <p class="text-white-50 mb-1">02-222 Warszawa</p>
                    <p class="text-white-50">NIP: 525-284-91-02</p>
                </div>
                <div class="col-md-2 small">
                    <h6 class="text-uppercase fw-bold mb-3">Godziny otwarcia</h6>
                    <p class="text-white-50 mb-1">Pon–Pt: 05:00–17:00</p>
                    <p class="text-white-50 mb-1">Sobota: 05:00–13:00</p>
                    <p class="text-white-50">Niedziela: nieczynne</p>
                </div>
            </div>
            <div class="d-flex justify-content-between pt-3 small text-white-50">
                <span>© 2026 FreshFlow. Wszelkie prawa zastrzeżone.</span>
                <span>Polityka prywatności · Regulamin</span>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>