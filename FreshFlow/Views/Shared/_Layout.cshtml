<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreshFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        bool isClientPortalArea = currentController == "ClientPanel" || currentController == "Orders";
    }

    <nav class="navbar navbar-expand-lg bg-white border-bottom py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark" asp-controller="Home" asp-action="Index">
                <span class="p-2 rounded-3 text-white" style="background-color:#00796B;">🍃</span>
                FreshFlow
            </a>

            @if (!isClientPortalArea)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                    <ul class="navbar-nav gap-4 small fw-semibold my-2 my-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" asp-fragment="o-nas">O nas</a>
                        </li>
                        <li class="nav-item">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a class="nav-link text-dark" asp-controller="ClientPanel" asp-action="Index">Nasza Oferta</a>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Nasza Oferta</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" asp-fragment="kontakt">Kontakt</a>
                        </li>
                    </ul>
                </div>
            }

            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Administrator") || User.IsInRole("Kierownik"))
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-dark btn-sm px-3 py-2 fw-semibold">
                            ⚙️ Panel ERP
                        </a>
                    }
                    else if (User.IsInRole("Magazynier"))
                    {
                        <a asp-controller="Logistics" asp-action="WarehousePanel" class="btn btn-dark btn-sm px-3 py-2 fw-semibold">
                            📦 Panel Magazyniera
                        </a>
                    }
                    else if (User.IsInRole("Dostawca"))
                    {
                        <a asp-controller="Logistics" asp-action="DeliveryPanel" class="btn btn-dark btn-sm px-3 py-2 fw-semibold">
                            🚚 Panel Dostawcy
                        </a>
                    }

                    <a asp-controller="ClientPanel" asp-action="Index" class="btn btn-outline-dark btn-sm px-3 py-2 fw-semibold">
                        Portal Klienta
                    </a>
                    <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                        Moje Zamówienia
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm text-white px-3 py-2 fw-semibold" style="background-color:#00796B;">
                            Wyloguj (@User.Identity.Name)
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-mode="client" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                        Zaloguj jako Klient
                    </a>
                    <a asp-controller="Account" asp-action="Login" asp-route-mode="employee" class="btn btn-sm text-white px-3 py-2 fw-semibold" style="background-color:#00796B;">
                        Panel Pracownika
                    </a>
                }
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer id="kontakt" class="text-white pt-5 pb-4 mt-auto" style="background-color: #101828;">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-5 mb-2">
                        <span class="p-2 rounded-3" style="background-color:#00796B;">🍃</span> FreshFlow
                    </div>
                    <p class="small text-white-50">Twój zaufany partner w dostawach świeżych warzyw i owoców dla gastronomii i handlu.</p>
                </div>
                <div class="col-md-3 small">
                    <h6 class="text-uppercase fw-bold mb-3">Kontakt</h6>
                    <p class="text-white-50 mb-1">+48 22 450 20 10</p>
                    <p class="text-white-50 mb-1">biuro@freshflow.pl</p>
                    <p class="text-white-50">zamowienia@freshflow.pl</p>
                </div>
                <div class="col-md-3 small">
                    <h6 class="text-uppercase fw-bold mb-3">Hurtownia</h6>
                    <p class="text-white-50 mb-1">ul. Logistyczna 12</p>
                    <p class="text-white-50 mb-1">02-222 Warszawa</p>
                    <p class="text-white-50">NIP: 525-284-91-02</p>
                </div>
                <div class="col-md-2 small">
                    <h6 class="text-uppercase fw-bold mb-3">Godziny otwarcia</h6>
                    <p class="text-white-50 mb-1">Pon–Pt: 05:00–17:00</p>
                    <p class="text-white-50 mb-1">Sobota: 05:00–13:00</p>
                    <p class="text-white-50">Niedziela: nieczynne</p>
                </div>
            </div>
            <div class="d-flex justify-content-between pt-3 small text-white-50">
                <span>© 2026 FreshFlow. Wszelkie prawa zastrzeżone.</span>
                <span>Polityka prywatności · Regulamin</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>