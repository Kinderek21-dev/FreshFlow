@model IEnumerable<FreshFlow.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Zarządzanie Produktami (CRUD)";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Katalog Produktów — Panel Zarządzania (CRUD)</h3>
        <p class="text-muted small mb-0">Dodawaj, edytuj i usuwaj warzywa oraz owoce w ofercie hurtowni.</p>
    </div>
    <a asp-action="Create" class="btn text-white fw-semibold px-4" style="background-color:#00796B;">+ Dodaj nowy produkt</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>Nazwa</th>
                <th>Kategoria</th>
                <th>Kraj</th>
                <th>Cena (zł/kg)</th>
                <th>Stan (kg)</th>
                <th class="text-end">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.BarcodeSKU</td>
                    <td>@item.Name</td>
                    <td><span class="badge rounded-pill px-3 py-2" style="background-color:#e6f4f1; color:#00796B;">@item.Category?.Name</span></td>
                    <td>@item.OriginCountry</td>
                    <td>@item.BasePricePerKg.ToString("0.00") zł</td>
                    <td>@item.StockQuantity kg</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-secondary">Podgląd</a>
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Edytuj</a>
                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Usunąć produkt?');">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
