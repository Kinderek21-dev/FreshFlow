@model FreshFlow.Models.Supplier
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edycja Rolnika / Kontrahenta";
}

<div class="col-lg-8 mx-auto bg-white p-4 rounded-4 shadow-sm border">
    <h4 class="fw-bold mb-1">Edycja dostawcy: @Model.FarmName</h4>
    <p class="text-muted small mb-4">Zaktualizuj dane kontaktowe lub specjalizację gospodarstwa.</p>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="SupplierId" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="FarmName" class="form-label small fw-semibold"></label>
                <input asp-for="FarmName" class="form-control" />
                <span asp-validation-for="FarmName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NIP" class="form-label small fw-semibold"></label>
                <input asp-for="NIP" class="form-control" />
                <span asp-validation-for="NIP" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ContactPerson" class="form-label small fw-semibold"></label>
                <input asp-for="ContactPerson" class="form-control" />
                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PhoneNumber" class="form-label small fw-semibold"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label small fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Region" class="form-label small fw-semibold"></label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Specialization" class="form-label small fw-semibold"></label>
                <input asp-for="Specialization" class="form-control" />
                <span asp-validation-for="Specialization" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn text-white px-4 fw-semibold" style="background-color:#00796B;">Zapisz zmiany</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}