@model IEnumerable<FreshFlow.Models.ViewModels.UserListItemViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Użytkownicy Systemu (CRUD)</h3>
        <p class="text-muted small mb-0">Zarządzaj kontami klientów, pracowników, rolami oraz blokadami dostępu.</p>
    </div>
    <a asp-action="Create" class="btn text-white fw-semibold px-4" style="background-color:#00796B;">
        + Dodaj użytkownika
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}

<form method="get" class="row g-2 mb-4 bg-white p-3 rounded-4 shadow-sm border">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Szukaj po imieniu, nazwisku lub adresie e-mail..." />
    </div>
    <div class="col-md-4">
        <select name="roleFilter" asp-items="ViewBag.Roles" class="form-select">
            <option value="">Wszystkie role</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn w-100 text-white fw-semibold" style="background-color:#00796B;">Filtruj</button>
    </div>
</form>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Imię i nazwisko</th>
                <th>E-mail</th>
                <th>Firma / NIP</th>
                <th>Rola</th>
                <th>Status</th>
                <th class="text-end">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.FullName</td>
                    <td>@u.Email</td>
                    <td class="small text-muted">
                        @(string.IsNullOrEmpty(u.CompanyName) ? "—" : $"{u.CompanyName} (NIP: {u.NIP})")
                    </td>
                    <td>
                        <span class="badge rounded-pill px-3 py-2" style="background-color:#e6f4f1; color:#00796B;">@u.Role</span>
                    </td>
                    <td>
                        @if (u.IsBlocked)
                        {
                            <span class="badge bg-danger">Zablokowany</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Aktywny</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edytuj / Hasło</a>
                        <form asp-action="ToggleBlock" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(u.IsBlocked ? "btn-outline-success" : "btn-outline-warning")">
                                @(u.IsBlocked ? "Odblokuj" : "Zablokuj")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno usunąć tego użytkownika?');">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>