@model IEnumerable<FreshFlow.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Raporty Sprzedaży i Dostaw";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Raporty o Sprzedaży i Zrealizowanych Dostawach</h3>
        <p class="text-muted small mb-0">Zestawienie przychodów B2B, wolumenu sprzedanych towarów oraz wykonanych kursów chłodniczych.</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="ExportCsv"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-onlyDelivered="@ViewBag.OnlyDelivered"
           class="btn text-white fw-semibold btn-sm px-3 py-2" style="background-color:#00796B;">
            Pobierz raport CSV (Excel)
        </a>
        <button onclick="window.print()" class="btn btn-outline-dark fw-semibold btn-sm px-3 py-2">
            Drukuj / Zapisz PDF
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Data dostawy od:</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Data dostawy do:</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="onlyDelivered" value="true" id="onlyDeliveredCheck"
                       @(ViewBag.OnlyDelivered == true ? "checked" : "") />
                <label class="form-check-label small fw-semibold" for="onlyDeliveredCheck">
                    Tylko zrealizowane dostawy
                </label>
            </div>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-dark btn-sm px-4 fw-semibold w-100">Generuj raport</button>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
            <small class="text-muted text-uppercase fw-bold" style="font-size:11px;">Przychód Netto</small>
            <h4 class="fw-bold mt-1 mb-0" style="color:#00796B;">@(((decimal)ViewBag.TotalRevenueNet).ToString("0.00")) zł</h4>
            <small class="text-muted">Brutto z VAT: <strong>@(((decimal)ViewBag.TotalRevenueGross).ToString("0.00")) zł</strong></small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
            <small class="text-muted text-uppercase fw-bold" style="font-size:11px;">Sprzedany Wolumen</small>
            <h4 class="fw-bold mt-1 mb-0">@ViewBag.TotalKgSold kg</h4>
            <small class="text-muted">Łączna waga zamówionego towaru</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
            <small class="text-muted text-uppercase fw-bold" style="font-size:11px;">Zrealizowane Dostawy</small>
            <h4 class="fw-bold mt-1 mb-0 text-success">@ViewBag.DeliveredCount</h4>
            <small class="text-muted">Wszystkich zamówień w okresie: @ViewBag.TotalOrdersCount</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
            <small class="text-muted text-uppercase fw-bold" style="font-size:11px;">W Trakcie Realizacji</small>
            <h4 class="fw-bold mt-1 mb-0 text-primary">@ViewBag.InProgressCount</h4>
            <small class="text-muted">Magazyn / Transport chłodniczy</small>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">Szczegółowy wykaz zamówień i dostaw (@Model.Count())</h6>
        <small class="text-muted">Okres: @ViewBag.FromDate do @ViewBag.ToDate</small>
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nr</th>
                <th>Klient / Firma</th>
                <th>Produkt</th>
                <th>Ilość</th>
                <th>Kwota Netto</th>
                <th>Termin dostawy</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="fw-bold">#@o.OrderId</td>
                    <td>
                        <div class="fw-semibold">@(o.Client?.CompanyName ?? o.Client?.Email)</div>
                        <small class="text-muted">NIP: @(o.Client?.NIP ?? "-")</small>
                    </td>
                    <td>@o.Product?.Name <small class="text-muted">(@o.Product?.BarcodeSKU)</small></td>
                    <td class="fw-semibold">@o.QuantityKg kg</td>
                    <td class="fw-bold" style="color:#00796B;">@o.TotalPriceNet.ToString("0.00") zł</td>
                    <td>@o.PreferredDeliveryDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (o.Status == FreshFlow.Models.OrderStatus.Dostarczone)
                        {
                            <span class="badge bg-success">Dostarczone</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@o.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>