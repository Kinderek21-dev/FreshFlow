@model IEnumerable<FreshFlow.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Panel Magazyniera — Kompletacja";
}

<div class="mb-4">
    <h3 class="fw-bold mb-0">Panel Magazyniera — Kompletacja Zamówień</h3>
    <p class="text-muted small mb-0">Kompletuj zamówienia spływające od klientów i przekazuj gotowe palety do Panelu Dostawcy.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nr</th>
                <th>Klient / Firma</th>
                <th>Towar (SKU)</th>
                <th>Ilość</th>
                <th>Data dostawy</th>
                <th>Data ważności partii</th>
                <th>Status</th>
                <th class="text-end">Akcja Magazyniera</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="fw-bold">#@o.OrderId</td>
                    <td>@(o.Client?.CompanyName ?? o.Client?.Email)</td>
                    <td>@o.Product?.Name <small class="text-muted">(@o.Product?.BarcodeSKU)</small></td>
                    <td class="fw-bold">@o.QuantityKg kg</td>
                    <td>@o.PreferredDeliveryDate.ToString("dd.MM.yyyy") <small class="text-muted">(@o.PreferredDeliveryTimeWindow)</small></td>
                    <td><span class="badge bg-light text-dark border">@o.Product?.ExpirationDate.ToString("dd.MM.yyyy")</span></td>
                    <td>
                        <span class="badge bg-secondary">@o.Status</span>
                    </td>
                    <td class="text-end">
                        @if (o.Status == FreshFlow.Models.OrderStatus.Nowe)
                        {
                            <form asp-action="UpdateWarehouseStatus" method="post" class="d-inline">
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <input type="hidden" name="newStatus" value="@FreshFlow.Models.OrderStatus.WKompletacji" />
                                <button type="submit" class="btn btn-sm btn-warning fw-semibold">
                                    Rozpocznij kompletację
                                </button>
                            </form>
                        }
                        else if (o.Status == FreshFlow.Models.OrderStatus.WKompletacji)
                        {
                            <form asp-action="UpdateWarehouseStatus" method="post" class="d-inline">
                                <input type="hidden" name="orderId" value="@o.OrderId" />
                                <input type="hidden" name="newStatus" value="@FreshFlow.Models.OrderStatus.GotoweDlaDostawcy" />
                                <button type="submit" class="btn btn-sm text-white fw-semibold" style="background-color:#00796B;">
                                    ✓ Skompletowano → Przekaż Dostawcy
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Przekazano dalej (@o.Status)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>